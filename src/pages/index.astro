---
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import { getCollection } from 'astro:content';
import { 
  Search, 
  X, 
  Clock, 
  ArrowDownAZ, 
  User, 
  RotateCcw,
  BookOpen,
  ChevronDown
} from '@lucide/astro';
import { compareBooks } from '../utils/catalog.js';

const allBooks = await getCollection('books');

// Sort by date added descending by default (DESIGN.md 8.2), with year and title as tie-breakers
const sortedBooks = [...allBooks].sort((a, b) => {
  return compareBooks(
    {
      id: a.id,
      title: a.data.title.toLowerCase(),
      author: a.data.author.toLowerCase(),
      added: a.data.addedAt ? new Date(a.data.addedAt).getTime() : 0,
      year: a.data.year || 0,
    },
    {
      id: b.id,
      title: b.data.title.toLowerCase(),
      author: b.data.author.toLowerCase(),
      added: b.data.addedAt ? new Date(b.data.addedAt).getTime() : 0,
      year: b.data.year || 0,
    },
    'recent'
  );
});
---

<Layout title="Каталог книг">
  <div class="max-w-[1200px] mx-auto px-5 sm:px-8 lg:px-10 pt-5 sm:pt-8 pb-16">
    <!-- Accessible hidden document H1 for screen readers -->
    <h1 class="sr-only">Каталог книг</h1>

    <!-- Single Unified Toolbar: Search Input + Sorting Group -->
    <div class="flex flex-col md:flex-row items-stretch md:items-center gap-3 mb-6 sm:mb-8 lg:mb-11">
      <!-- Search Bar (takes all flexible space) -->
      <search class="relative flex-1 min-w-0" role="search">
        <label for="catalog-search" class="sr-only">Поиск по библиотеке</label>
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-[var(--color-placeholder)]">
          <Search class="w-5 h-5 stroke-[1.8]" />
        </div>
        <input
          type="text"
          id="catalog-search"
          placeholder="Название, автор или ISBN"
          autocomplete="off"
          class="w-full h-[48px] pl-12 pr-12 bg-[var(--color-surface)] border border-[var(--color-control-border)] rounded-[var(--radius-control)] text-[16px] text-[var(--color-text)] placeholder-[var(--color-placeholder)] focus:border-[var(--color-primary)] focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-[var(--color-focus)] focus-visible:ring-offset-3 transition-colors"
        />
        <button
          type="button"
          id="search-clear-btn"
          class="hidden absolute inset-y-0 right-0 w-12 flex items-center justify-center text-[var(--color-placeholder)] hover:text-[var(--color-text)] cursor-pointer"
          aria-label="Очистить поиск"
        >
          <X class="w-5 h-5 stroke-[1.8]" />
        </button>
      </search>

      <!-- Sorting Button Group for Desktop/Tablet (hidden on mobile < 768px, Fix 4) -->
      <div 
        id="catalog-sort-radiogroup"
        class="hidden md:inline-flex items-center p-0.5 bg-[var(--color-surface)] border border-[var(--color-control-border)] rounded-[var(--radius-control)] h-[48px] gap-1 shrink-0"
        role="radiogroup" 
        aria-label="Сортировка книг"
      >
        <button
          type="button"
          class="sort-btn h-full px-3.5 rounded-[6px] text-[14px] font-medium transition-colors cursor-pointer flex items-center gap-2 bg-[var(--color-primary)] text-[var(--color-on-primary)] shadow-xs"
          data-sort="recent"
          role="radio"
          aria-checked="true"
          tabindex="0"
        >
          <Clock class="w-4 h-4 stroke-[2]" />
          <span>Недавно</span>
        </button>
        <button
          type="button"
          class="sort-btn h-full px-3.5 rounded-[6px] text-[14px] font-medium transition-colors cursor-pointer flex items-center gap-2 text-[var(--color-text)] hover:bg-[var(--color-hover-surface)]"
          data-sort="title"
          role="radio"
          aria-checked="false"
          tabindex="-1"
        >
          <ArrowDownAZ class="w-4 h-4 stroke-[2]" />
          <span>По названию</span>
        </button>
        <button
          type="button"
          class="sort-btn h-full px-3.5 rounded-[6px] text-[14px] font-medium transition-colors cursor-pointer flex items-center gap-2 text-[var(--color-text)] hover:bg-[var(--color-hover-surface)]"
          data-sort="author"
          role="radio"
          aria-checked="false"
          tabindex="-1"
        >
          <User class="w-4 h-4 stroke-[2]" />
          <span>По автору</span>
        </button>
      </div>

      <!-- Mobile Sort Select (< 768px, DESIGN.md 11.1, Fix 4) -->
      <div class="flex md:hidden items-center gap-3 w-full">
        <label for="catalog-sort-mobile" class="text-[14px] font-medium text-[var(--color-muted)] shrink-0">
          Сортировка
        </label>
        <div class="relative flex-1">
          <select
            id="catalog-sort-mobile"
            class="w-full h-[48px] pl-3.5 pr-10 bg-[var(--color-surface)] border border-[var(--color-control-border)] rounded-[var(--radius-control)] text-[16px] text-[var(--color-text)] focus:border-[var(--color-primary)] focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-[var(--color-focus)] focus-visible:ring-offset-3 transition-colors appearance-none cursor-pointer"
          >
            <option value="recent">Недавно</option>
            <option value="title">По названию</option>
            <option value="author">По автору</option>
          </select>
          <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-[var(--color-muted)]">
            <ChevronDown class="w-4 h-4 stroke-[2]" />
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile Active Tag Banner (< 1024px, DESIGN.md 11.1, Fix 7) -->
    <div
      id="mobile-active-genre-banner"
      class="hidden lg:hidden mb-6 p-2.5 sm:p-3 bg-[var(--color-surface)] border border-[var(--color-control-border)] rounded-[var(--radius-control)] flex items-center justify-between gap-3"
    >
      <div class="flex items-center gap-2 min-w-0 pl-1">
        <span class="text-[14px] text-[var(--color-muted)] shrink-0">Ярлык:</span>
        <span id="mobile-active-genre-name" class="text-[15px] font-medium text-[var(--color-heading)] break-words"></span>
      </div>
      <button
        type="button"
        id="mobile-reset-genre-btn"
        class="min-h-[44px] min-w-[44px] px-3 py-2 rounded-[var(--radius-control)] text-[14px] font-medium text-[var(--color-focus)] hover:text-[var(--color-focus)] hover:bg-[var(--color-hover-surface)] focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-[var(--color-focus)] focus-visible:ring-offset-3 transition-colors cursor-pointer shrink-0 flex items-center justify-center gap-1.5"
        aria-label="Сбросить выбранный ярлык"
      >
        <X class="w-4 h-4 stroke-[2]" />
        <span>Сбросить ярлык</span>
      </button>
    </div>

    <!-- Accessible Live Announcement Region (DESIGN.md 8.1) -->
    <div id="catalog-live-feedback" aria-live="polite" aria-atomic="true" class="sr-only"></div>

    <!-- Catalog Content -->
    <div id="catalog-container">
      <!-- Grid View: 4 columns on desktop, gap 48px/40px -->
      <div 
        id="catalog-grid" 
        class={`grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-x-6 sm:gap-x-8 xl:gap-x-12 gap-y-10 ${sortedBooks.length === 0 ? 'hidden' : ''}`}
      >
        {sortedBooks.map((book) => (
          <BookCard book={book} />
        ))}
      </div>

      <!-- Empty Results State -->
      <div id="empty-state" class={`${sortedBooks.length === 0 ? '' : 'hidden'} text-center py-20 px-4`}>
        <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-[var(--color-hover-surface)] flex items-center justify-center text-[var(--color-muted)]">
          <BookOpen class="w-8 h-8 stroke-[1.5]" />
        </div>
        <h3 id="empty-title" class="font-['Inter'] text-[20px] font-semibold leading-[28px] text-[var(--color-heading)] mb-2">
          {sortedBooks.length === 0 ? 'В библиотеке пока нет книг' : 'Книги не найдены'}
        </h3>
        <p id="empty-description" class="text-[16px] leading-[24px] text-[var(--color-muted)] max-w-md mx-auto mb-6">
          {sortedBooks.length === 0 ? 'Добавьте первую книгу с помощью скрипта scripts/book_scanner.py.' : 'По вашему текущему запросу и ярлыкам ничего не найдено.'}
        </p>
        <button
          type="button"
          id="reset-all-btn"
          class={`h-[46px] px-6 rounded-[var(--radius-control)] bg-[var(--color-primary)] text-[var(--color-on-primary)] text-[15px] font-medium hover:bg-[var(--color-primary-hover)] focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-[var(--color-focus)] focus-visible:ring-offset-3 transition-colors cursor-pointer inline-flex items-center gap-2 ${sortedBooks.length === 0 ? 'hidden' : ''}`}
        >
          <RotateCcw class="w-4 h-4 stroke-[2]" />
          <span>Сбросить поиск и ярлыки</span>
        </button>
      </div>
    </div>
  </div>
</Layout>

<!-- Client Catalog Controller -->
<script>
  import { normalize, matchesFilter, compareBooks } from '../utils/catalog.js';

  // Module-scoped listeners and timers for clean teardown across page transitions (Fix 11)
  let popStateListener: (() => void) | null = null;
  let keyDownListener: ((e: KeyboardEvent) => void) | null = null;
  let searchDebounceTimer: number | undefined;

  function initCatalogController() {
    if (!document.getElementById('catalog-grid')) return;

    const searchInput = document.getElementById('catalog-search') as HTMLInputElement | null;
    const searchClearBtn = document.getElementById('search-clear-btn');
    const resetAllBtn = document.getElementById('reset-all-btn');
    const emptyState = document.getElementById('empty-state');
    const emptyTitle = document.getElementById('empty-title');
    const emptyDesc = document.getElementById('empty-description');
    const catalogGrid = document.getElementById('catalog-grid');
    const liveFeedback = document.getElementById('catalog-live-feedback');

    // Sorting elements (Fix 4)
    const sortRadioGroup = document.getElementById('catalog-sort-radiogroup');
    const sortBtns = document.querySelectorAll('.sort-btn');
    const mobileSortSelect = document.getElementById('catalog-sort-mobile') as HTMLSelectElement | null;

    // Mobile active genre banner (Fix 7)
    const mobileActiveGenreBanner = document.getElementById('mobile-active-genre-banner');
    const mobileActiveGenreName = document.getElementById('mobile-active-genre-name');
    const mobileResetGenreBtn = document.getElementById('mobile-reset-genre-btn');

    // Sidebar tag buttons
    const navGenreBtns = document.querySelectorAll('.nav-genre-btn');

    // Clear any previous debounce timer on re-init
    if (searchDebounceTimer) {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = undefined;
    }

    // State
    let searchQuery = '';
    if (searchInput && searchInput.value.trim()) {
      searchQuery = normalize(searchInput.value);
      searchClearBtn?.classList.remove('hidden');
    }
    const initialGenre = new URLSearchParams(window.location.search).get('genre');
    let selectedGenre = initialGenre ? normalize(initialGenre) : '';
    let currentSort = 'recent'; // recent, title, author
    if (mobileSortSelect) {
      mobileSortSelect.value = currentSort;
    }

    function flushPendingSearch() {
      if (searchDebounceTimer) {
        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = undefined;
      }
      searchQuery = normalize(searchInput?.value || '');
    }

    function getGenreDisplayName(genreSlug: string): string {
      if (!genreSlug) return '';
      for (const btn of Array.from(navGenreBtns)) {
        const btnGenre = normalize((btn as HTMLElement).dataset.navGenre || '');
        if (btnGenre === genreSlug) {
          const nameSpan = btn.querySelector('span.truncate');
          if (nameSpan && nameSpan.textContent) {
            return nameSpan.textContent.trim();
          }
        }
      }
      return genreSlug.charAt(0).toUpperCase() + genreSlug.slice(1);
    }

    function updateActiveNavUI() {
      // Update tag buttons in sidebar
      navGenreBtns.forEach((btn) => {
        const genreVal = normalize((btn as HTMLElement).dataset.navGenre || '');
        const countSpan = btn.querySelector('.genre-count');
        const iconWrap = btn.querySelector('.tag-icon-wrap');
        const isActive = (selectedGenre === '' && genreVal === '') || (selectedGenre !== '' && genreVal === selectedGenre);

        if (isActive) {
          btn.setAttribute('aria-current', 'page');
          btn.classList.add('bg-[var(--color-primary)]', 'text-[var(--color-on-primary)]', 'font-medium');
          btn.classList.remove('text-[var(--color-text)]', 'hover:bg-[var(--color-hover-surface)]', 'font-normal');
          countSpan?.classList.add('text-[var(--color-on-primary)]');
          countSpan?.classList.remove('text-[var(--color-muted)]');
          iconWrap?.classList.remove('text-[var(--color-muted)]');
          iconWrap?.classList.add('text-[var(--color-on-primary)]');
        } else {
          btn.removeAttribute('aria-current');
          btn.classList.remove('bg-[var(--color-primary)]', 'text-[var(--color-on-primary)]', 'font-medium');
          btn.classList.add('text-[var(--color-text)]', 'hover:bg-[var(--color-hover-surface)]', 'font-normal');
          countSpan?.classList.remove('text-[var(--color-on-primary)]');
          countSpan?.classList.add('text-[var(--color-muted)]');
          iconWrap?.classList.add('text-[var(--color-muted)]');
          iconWrap?.classList.remove('text-[var(--color-on-primary)]');
        }
      });

      // Update mobile active tag banner (DESIGN.md 11.1, Fix 7)
      if (mobileActiveGenreBanner && mobileActiveGenreName) {
        if (selectedGenre) {
          mobileActiveGenreName.textContent = getGenreDisplayName(selectedGenre);
          mobileActiveGenreBanner.classList.remove('hidden');
        } else {
          mobileActiveGenreBanner.classList.add('hidden');
          mobileActiveGenreName.textContent = '';
        }
      }
    }

    function applyFilterAndSort() {
      const gridItems = Array.from(document.querySelectorAll('#catalog-grid .book-item')) as HTMLElement[];
      let visibleCount = 0;

      // Filter grid items using matchesFilter from catalog.js (Fix 1 part 2)
      gridItems.forEach((el) => {
        let itemGenres: string | string[] = el.dataset.genres || '';
        try {
          if (typeof itemGenres === 'string' && itemGenres.startsWith('[')) {
            itemGenres = JSON.parse(itemGenres);
          }
        } catch {}

        const isVisible = matchesFilter(
          {
            title: el.dataset.title,
            author: el.dataset.author,
            isbn: el.dataset.isbn,
            genres: itemGenres,
          },
          searchQuery,
          selectedGenre
        );

        if (isVisible) {
          el.style.display = '';
          visibleCount++;
        } else {
          el.style.display = 'none';
        }
      });

      // Sorting using compareBooks from catalog.js (Fix 1 part 2)
      if (catalogGrid) {
        gridItems.sort((a, b) => compareBooks(a.dataset, b.dataset, currentSort));
        gridItems.forEach((item) => catalogGrid.appendChild(item));
      }

      // Empty states handling (UI-CONV-07)
      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
          if (catalogGrid) catalogGrid.classList.add('hidden');

          const resetBtnText = resetAllBtn?.querySelector('span');
          if (gridItems.length === 0) {
            if (emptyTitle) emptyTitle.textContent = 'В библиотеке пока нет книг';
            if (emptyDesc) emptyDesc.textContent = 'В вашей библиотеке пока нет ни одной книги.';
            if (resetAllBtn) resetAllBtn.classList.add('hidden');
          } else if (selectedGenre && !searchQuery) {
            if (emptyTitle) emptyTitle.textContent = 'В этом ярлыке пока нет книг';
            if (emptyDesc) emptyDesc.textContent = 'С выбранным ярлыком пока нет книг.';
            if (resetBtnText) resetBtnText.textContent = 'Все книги';
            if (resetAllBtn) resetAllBtn.classList.remove('hidden');
          } else if (!selectedGenre && searchQuery) {
            if (emptyTitle) emptyTitle.textContent = 'Книги не найдены';
            if (emptyDesc) emptyDesc.textContent = 'По вашему текущему запросу ничего не найдено.';
            if (resetBtnText) resetBtnText.textContent = 'Очистить поиск';
            if (resetAllBtn) resetAllBtn.classList.remove('hidden');
          } else {
            if (emptyTitle) emptyTitle.textContent = 'Книги не найдены';
            if (emptyDesc) emptyDesc.textContent = 'По вашему текущему запросу и ярлыку ничего не найдено.';
            if (resetBtnText) resetBtnText.textContent = 'Сбросить поиск и ярлык';
            if (resetAllBtn) resetAllBtn.classList.remove('hidden');
          }
        } else {
          emptyState.classList.add('hidden');
          if (catalogGrid) catalogGrid.classList.remove('hidden');
        }
      }

      // Accessible live feedback (DESIGN.md 8.1)
      if (liveFeedback) {
        if (visibleCount === 0) {
          liveFeedback.textContent = 'Книги не найдены';
        } else {
          const mod10 = visibleCount % 10;
          const mod100 = visibleCount % 100;
          let word = 'книг';
          if (mod100 < 11 || mod100 > 14) {
            if (mod10 === 1) word = 'книга';
            else if (mod10 >= 2 && mod10 <= 4) word = 'книги';
          }
          liveFeedback.textContent = `Найдено ${visibleCount} ${word}`;
        }
      }

      updateActiveNavUI();
    }

    // Search events with 250ms debounce and Enter instant trigger (DESIGN.md 8.1)
    searchInput?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      if (searchClearBtn) {
        if (val.trim()) {
          searchClearBtn.classList.remove('hidden');
        } else {
          searchClearBtn.classList.add('hidden');
        }
      }
      if (searchDebounceTimer) {
        clearTimeout(searchDebounceTimer);
      }
      searchDebounceTimer = window.setTimeout(() => {
        searchQuery = normalize(val);
        applyFilterAndSort();
      }, 250);
    });

    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        if (e.isComposing) return;
        flushPendingSearch();
        applyFilterAndSort();
      }
    });

    searchClearBtn?.addEventListener('click', () => {
      if (searchInput) {
        if (searchDebounceTimer) {
          clearTimeout(searchDebounceTimer);
          searchDebounceTimer = undefined;
        }
        searchInput.value = '';
        searchQuery = '';
        searchClearBtn.classList.add('hidden');
        searchInput.focus();
        applyFilterAndSort();
      }
    });

    // Sorting state updater with roving tabindex and mobile select sync (Fix 4)
    function setSort(sortVal: string, moveFocus = false) {
      flushPendingSearch();
      currentSort = sortVal;

      if (mobileSortSelect && mobileSortSelect.value !== sortVal) {
        mobileSortSelect.value = sortVal;
      }

      sortBtns.forEach((b) => {
        const btnEl = b as HTMLButtonElement;
        const isCurrent = btnEl.dataset.sort === currentSort;
        if (isCurrent) {
          btnEl.classList.add('bg-[var(--color-primary)]', 'text-[var(--color-on-primary)]', 'shadow-xs');
          btnEl.classList.remove('text-[var(--color-text)]', 'hover:bg-[var(--color-hover-surface)]');
          btnEl.setAttribute('aria-checked', 'true');
          btnEl.setAttribute('tabindex', '0');
          if (moveFocus) {
            btnEl.focus();
          }
        } else {
          btnEl.classList.remove('bg-[var(--color-primary)]', 'text-[var(--color-on-primary)]', 'shadow-xs');
          btnEl.classList.add('text-[var(--color-text)]', 'hover:bg-[var(--color-hover-surface)]');
          btnEl.setAttribute('aria-checked', 'false');
          btnEl.setAttribute('tabindex', '-1');
        }
      });

      applyFilterAndSort();
    }

    // Sort buttons click event binding
    sortBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const sortVal = (btn as HTMLElement).dataset.sort || 'recent';
        setSort(sortVal, false);
      });
    });

    // Arrow keys roving tabindex on desktop radiogroup (Fix 4)
    sortRadioGroup?.addEventListener('keydown', (e) => {
      const btnArray = Array.from(sortBtns) as HTMLButtonElement[];
      const currentIndex = btnArray.findIndex((b) => b.dataset.sort === currentSort);
      if (currentIndex === -1) return;

      let newIndex = -1;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        newIndex = (currentIndex + 1) % btnArray.length;
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        newIndex = (currentIndex - 1 + btnArray.length) % btnArray.length;
      }

      if (newIndex !== -1) {
        e.preventDefault();
        const targetSort = btnArray[newIndex].dataset.sort || 'recent';
        setSort(targetSort, true);
      }
    });

    // Mobile select change event (Fix 4)
    mobileSortSelect?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      setSort(val, false);
    });

    // Synchronize URL genre query param (Fix 12)
    function syncUrlGenre() {
      const url = new URL(window.location.href);
      if (selectedGenre) {
        url.searchParams.set('genre', selectedGenre);
      } else {
        url.searchParams.delete('genre');
      }
      const newSearch = url.search || '';
      if (window.location.search !== newSearch) {
        window.history.pushState({}, '', url.pathname + newSearch);
      }
    }

    // Reset filters
    function resetAllFilters() {
      selectedGenre = '';
      syncUrlGenre();
      applyFilterAndSort();
    }

    resetAllBtn?.addEventListener('click', () => {
      flushPendingSearch();

      if (selectedGenre && !searchQuery) {
        resetAllFilters();
      } else if (!selectedGenre && searchQuery) {
        if (searchInput) {
          searchInput.value = '';
          searchQuery = '';
          searchClearBtn?.classList.add('hidden');
          searchInput.focus();
        }
        applyFilterAndSort();
      } else {
        if (searchInput) {
          searchInput.value = '';
          searchQuery = '';
          searchClearBtn?.classList.add('hidden');
        }
        resetAllFilters();
        searchInput?.focus();
      }
    });

    // Mobile reset genre button (resets only genre, preserving search and sort, Fix 7)
    mobileResetGenreBtn?.addEventListener('click', () => {
      flushPendingSearch();
      selectedGenre = '';
      syncUrlGenre();
      applyFilterAndSort();
    });

    // Sidebar tags binding
    navGenreBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const mouseEvent = e as MouseEvent;
        if (
          mouseEvent.defaultPrevented ||
          mouseEvent.button !== 0 ||
          mouseEvent.metaKey ||
          mouseEvent.ctrlKey ||
          mouseEvent.shiftKey ||
          mouseEvent.altKey
        ) {
          return;
        }

        // Prevent page reload since we're already on index page
        e.preventDefault();

        flushPendingSearch();

        const genre = normalize((btn as HTMLElement).dataset.navGenre || '');
        if (selectedGenre === genre && genre !== '') {
          selectedGenre = ''; // toggle off if clicked again
        } else {
          selectedGenre = genre;
        }
        syncUrlGenre();
        applyFilterAndSort();

        // Close mobile drawer if open and focus main content (IMP-06)
        const drawer = document.getElementById('mobile-drawer');
        if (drawer && !drawer.classList.contains('-translate-x-full')) {
          if (typeof (window as any).closeDrawer === 'function') {
            (window as any).closeDrawer('main');
          } else {
            document.getElementById('close-drawer-btn')?.click();
            document.getElementById('main-content')?.focus();
          }
        }
      });
    });

    // Listen to browser back/forward buttons
    function onPopState() {
      flushPendingSearch();
      const paramGenre = new URLSearchParams(window.location.search).get('genre');
      selectedGenre = paramGenre ? normalize(paramGenre) : '';
      applyFilterAndSort();
    }
    if (popStateListener) {
      window.removeEventListener('popstate', popStateListener);
    }
    popStateListener = onPopState;
    window.addEventListener('popstate', popStateListener);

    // Keyboard shortcuts: '/' and Cmd+K / Ctrl+K (Fix 9)
    function onKeyDown(e: KeyboardEvent) {
      if (e.defaultPrevented || e.isComposing) return;

      const drawer = document.getElementById('mobile-drawer');
      if (drawer && !drawer.hasAttribute('inert')) return;

      const isCmdK = (e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey) && !e.altKey;
      const isSlash = e.key === '/' && !e.metaKey && !e.ctrlKey && !e.altKey;

      if (isCmdK) {
        e.preventDefault();
        searchInput?.focus();
        searchInput?.select();
        return;
      }

      if (isSlash) {
        const tag = document.activeElement?.tagName || '';
        const isEditable = (document.activeElement as HTMLElement)?.isContentEditable;
        if (document.activeElement !== searchInput && !['INPUT', 'TEXTAREA', 'SELECT'].includes(tag) && !isEditable) {
          e.preventDefault();
          searchInput?.focus();
        }
      }
    }
    if (keyDownListener) {
      window.removeEventListener('keydown', keyDownListener);
    }
    keyDownListener = onKeyDown;
    window.addEventListener('keydown', keyDownListener);

    // Initial run
    applyFilterAndSort();
  }

  // Teardown before page swap (Fix 11)
  document.addEventListener('astro:before-swap', () => {
    if (searchDebounceTimer) {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = undefined;
    }
    if (popStateListener) {
      window.removeEventListener('popstate', popStateListener);
      popStateListener = null;
    }
    if (keyDownListener) {
      window.removeEventListener('keydown', keyDownListener);
      keyDownListener = null;
    }
  });

  initCatalogController();
  document.addEventListener('astro:after-swap', initCatalogController);
</script>
