---
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import { getCollection } from 'astro:content';
import { 
  Search, 
  X, 
  Clock, 
  ArrowDownAZ, 
  User, 
  RotateCcw,
  BookOpen
} from '@lucide/astro';

const allBooks = await getCollection('books');

// Sort by date added descending by default (DESIGN.md 8.2), with year and title as tie-breakers
const sortedBooks = [...allBooks].sort((a, b) => {
  const addedA = a.data.addedAt ? new Date(a.data.addedAt).getTime() : 0;
  const addedB = b.data.addedAt ? new Date(b.data.addedAt).getTime() : 0;
  const addedDiff = addedB - addedA;
  if (addedDiff !== 0) return addedDiff;
  const yearA = a.data.year || 0;
  const yearB = b.data.year || 0;
  if (yearB !== yearA) {
    return yearB - yearA;
  }
  return a.data.title.localeCompare(b.data.title, 'ru');
});
---

<Layout title="Каталог книг">
  <div class="max-w-[1280px] mx-auto px-5 sm:px-8 lg:px-10 pt-5 sm:pt-8 pb-16">
    <!-- Accessible hidden document H1 for screen readers -->
    <h1 class="sr-only">Каталог книг</h1>

    <!-- Single Unified Toolbar: Search Input + Sorting Button Group -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mb-6 sm:mb-8">
      <!-- Search Bar (takes all flexible space) -->
      <div class="relative flex-1 min-w-0">
        <label for="catalog-search" class="sr-only">Поиск по библиотеке</label>
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-[var(--color-placeholder)]">
          <Search class="w-5 h-5 stroke-[1.8]" />
        </div>
        <input
          type="text"
          id="catalog-search"
          placeholder="Название, автор или ISBN"
          autocomplete="off"
          class="w-full h-[48px] pl-12 pr-12 bg-[var(--color-surface)] border border-[var(--color-control-border)] rounded-[var(--radius-control)] text-[16px] text-[var(--color-text)] placeholder-[var(--color-placeholder)] focus:border-[var(--color-primary)] focus:outline-none transition-colors"
        />
        <button
          type="button"
          id="search-clear-btn"
          class="hidden absolute inset-y-0 right-0 w-12 flex items-center justify-center text-[var(--color-placeholder)] hover:text-[var(--color-text)] cursor-pointer"
          aria-label="Очистить поиск"
        >
          <X class="w-5 h-5 stroke-[1.8]" />
        </button>
      </div>

      <!-- Sorting Button Group with Icons -->
      <div 
        class="inline-flex items-center p-1 bg-[var(--color-surface)] border border-[var(--color-control-border)] rounded-[var(--radius-control)] h-[48px] gap-1 shrink-0 self-start sm:self-auto"
        role="group" 
        aria-label="Сортировка каталога"
      >
        <button
          type="button"
          class="sort-btn h-full px-3 sm:px-3.5 rounded-[6px] text-[14px] font-medium transition-colors cursor-pointer flex items-center gap-2 bg-[var(--color-primary)] text-[var(--color-on-primary)] shadow-xs"
          data-sort="recent"
          title="Недавно добавлены"
          aria-pressed="true"
        >
          <Clock class="w-4 h-4 stroke-[2]" />
          <span class="hidden sm:inline">Недавно</span>
        </button>
        <button
          type="button"
          class="sort-btn h-full px-3 sm:px-3.5 rounded-[6px] text-[14px] font-medium transition-colors cursor-pointer flex items-center gap-2 text-[var(--color-text)] hover:bg-[var(--color-hover-surface)]"
          data-sort="title"
          title="По названию: А–Я"
          aria-pressed="false"
        >
          <ArrowDownAZ class="w-4 h-4 stroke-[2]" />
          <span class="hidden sm:inline">По названию</span>
        </button>
        <button
          type="button"
          class="sort-btn h-full px-3 sm:px-3.5 rounded-[6px] text-[14px] font-medium transition-colors cursor-pointer flex items-center gap-2 text-[var(--color-text)] hover:bg-[var(--color-hover-surface)]"
          data-sort="author"
          title="По автору: А–Я"
          aria-pressed="false"
        >
          <User class="w-4 h-4 stroke-[2]" />
          <span class="hidden sm:inline">По автору</span>
        </button>
      </div>
    </div>

    <!-- Accessible Live Announcement Region (DESIGN.md 8.1) -->
    <div id="catalog-live-feedback" aria-live="polite" aria-atomic="true" class="sr-only"></div>

    <!-- Catalog Content -->
    <div id="catalog-container">
      <!-- Grid View: 4 columns on desktop, gap 56px -->
      <div 
        id="catalog-grid" 
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-x-6 sm:gap-x-8 xl:gap-x-14 gap-y-8"
      >
        {sortedBooks.map((book) => (
          <BookCard book={book} />
        ))}
      </div>

      <!-- Empty Results State -->
      <div id="empty-state" class="hidden text-center py-20 px-4">
        <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-[var(--color-hover-surface)] flex items-center justify-center text-[var(--color-muted)]">
          <BookOpen class="w-8 h-8 stroke-[1.5]" />
        </div>
        <h3 id="empty-title" class="font-['Lora'] text-[24px] font-medium text-[var(--color-heading)] mb-2">
          Книги не найдены
        </h3>
        <p id="empty-description" class="text-[15px] text-[var(--color-muted)] max-w-md mx-auto mb-6">
          По вашему текущему запросу и ярлыкам ничего не найдено.
        </p>
        <button
          type="button"
          id="reset-all-btn"
          class="h-[46px] px-6 rounded-[var(--radius-control)] bg-[var(--color-primary)] text-[var(--color-on-primary)] text-[15px] font-medium hover:bg-[var(--color-primary-hover)] transition-colors cursor-pointer inline-flex items-center gap-2"
        >
          <RotateCcw class="w-4 h-4 stroke-[2]" />
          <span>Сбросить поиск и ярлыки</span>
        </button>
      </div>
    </div>
  </div>
</Layout>

<!-- Client Catalog Controller -->
<script>
  function initCatalogController() {
    const searchInput = document.getElementById('catalog-search') as HTMLInputElement | null;
    const searchClearBtn = document.getElementById('search-clear-btn');
    const resetAllBtn = document.getElementById('reset-all-btn');
    const emptyState = document.getElementById('empty-state');
    const emptyTitle = document.getElementById('empty-title');
    const emptyDesc = document.getElementById('empty-description');
    const catalogGrid = document.getElementById('catalog-grid');
    const liveFeedback = document.getElementById('catalog-live-feedback');

    // Sort buttons
    const sortBtns = document.querySelectorAll('.sort-btn');

    // Sidebar tag buttons
    const navGenreBtns = document.querySelectorAll('.nav-genre-btn');

    // State
    let searchQuery = '';
    const initialGenre = new URLSearchParams(window.location.search).get('genre');
    let selectedGenre = initialGenre ? normalize(initialGenre) : '';
    let currentSort = 'recent'; // recent, title, author
    let searchDebounceTimer: number | undefined;

    function normalize(text: string): string {
      return text.toLowerCase().replace(/ё/g, 'е').trim();
    }

    function updateActiveNavUI() {
      // Update tag buttons in sidebar
      navGenreBtns.forEach((btn) => {
        const genreVal = normalize((btn as HTMLElement).dataset.navGenre || '');
        const countSpan = btn.querySelector('.genre-count');
        const iconWrap = btn.querySelector('.tag-icon-wrap');
        const isActive = (selectedGenre === '' && genreVal === '') || (selectedGenre !== '' && genreVal === selectedGenre);

        if (isActive) {
          btn.setAttribute('aria-current', 'page');
          btn.classList.add('bg-[var(--color-primary)]', 'text-[var(--color-on-primary)]');
          btn.classList.remove('text-[var(--color-text)]', 'hover:bg-[var(--color-hover-surface)]');
          countSpan?.classList.add('text-[var(--color-on-primary)]');
          countSpan?.classList.remove('text-[var(--color-muted)]');
          iconWrap?.classList.remove('text-[var(--color-muted)]');
          iconWrap?.classList.add('text-[var(--color-on-primary)]');
        } else {
          btn.removeAttribute('aria-current');
          btn.classList.remove('bg-[var(--color-primary)]', 'text-[var(--color-on-primary)]');
          btn.classList.add('text-[var(--color-text)]', 'hover:bg-[var(--color-hover-surface)]');
          countSpan?.classList.remove('text-[var(--color-on-primary)]');
          countSpan?.classList.add('text-[var(--color-muted)]');
          iconWrap?.classList.add('text-[var(--color-muted)]');
          iconWrap?.classList.remove('text-[var(--color-on-primary)]');
        }
      });
    }

    function applyFilterAndSort() {
      const gridItems = Array.from(document.querySelectorAll('#catalog-grid .book-item')) as HTMLElement[];
      let visibleCount = 0;

      // Filter grid items
      gridItems.forEach((el) => {
        const title = normalize(el.dataset.title || '');
        const author = normalize(el.dataset.author || '');
        const isbn = normalize(el.dataset.isbn || '');
        const genres = normalize(el.dataset.genres || '');

        let matchesSearch = true;
        if (searchQuery) {
          const cleanQuery = searchQuery.replace(/[-\s]/g, '');
          const queryWords = searchQuery.split(/\s+/).filter(Boolean);
          const matchesAllWords = queryWords.every((word) => title.includes(word) || author.includes(word));
          matchesSearch = matchesAllWords || (cleanQuery.length > 0 && isbn.includes(cleanQuery));
        }

        let matchesGenre = true;
        if (selectedGenre) {
          const itemGenres = genres.split(',').map((g) => g.trim());
          matchesGenre = itemGenres.includes(selectedGenre);
        }

        const isVisible = matchesSearch && matchesGenre;
        if (isVisible) {
          el.style.display = '';
          visibleCount++;
        } else {
          el.style.display = 'none';
        }
      });

      // Sorting
      if (catalogGrid) {
        gridItems.sort((a, b) => {
          if (currentSort === 'title') {
            const titleDiff = (a.dataset.title || '').localeCompare(b.dataset.title || '', 'ru');
            if (titleDiff !== 0) return titleDiff;
            const authorDiff = (a.dataset.author || '').localeCompare(b.dataset.author || '', 'ru');
            if (authorDiff !== 0) return authorDiff;
            return (a.dataset.id || '').localeCompare(b.dataset.id || '');
          } else if (currentSort === 'author') {
            const authorDiff = (a.dataset.author || '').localeCompare(b.dataset.author || '', 'ru');
            if (authorDiff !== 0) return authorDiff;
            const titleDiff = (a.dataset.title || '').localeCompare(b.dataset.title || '', 'ru');
            if (titleDiff !== 0) return titleDiff;
            return (a.dataset.id || '').localeCompare(b.dataset.id || '');
          } else {
            // "recent" mode: sort by date added descending (DESIGN.md 8.2)
            const addedA = parseInt(a.dataset.added || '0', 10);
            const addedB = parseInt(b.dataset.added || '0', 10);
            if (addedB !== addedA) {
              return addedB - addedA;
            }
            const yearA = parseInt(a.dataset.year || '0', 10);
            const yearB = parseInt(b.dataset.year || '0', 10);
            if (yearB !== yearA) {
              return yearB - yearA;
            }
            return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'ru');
          }
        });
        gridItems.forEach((item) => catalogGrid.appendChild(item));
      }

      // Empty states handling
      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
          if (catalogGrid) catalogGrid.classList.add('hidden');

          if (selectedGenre && !searchQuery) {
            if (emptyTitle) emptyTitle.textContent = 'Книги не найдены';
            if (emptyDesc) emptyDesc.textContent = 'С выбранным ярлыком пока нет книг.';
          } else {
            if (emptyTitle) emptyTitle.textContent = 'Книги не найдены';
            if (emptyDesc) emptyDesc.textContent = 'Попробуйте изменить поисковый запрос или сбросить фильтрацию.';
          }
        } else {
          emptyState.classList.add('hidden');
          if (catalogGrid) catalogGrid.classList.remove('hidden');
        }
      }

      // Accessible live feedback (DESIGN.md 8.1)
      if (liveFeedback) {
        if (visibleCount === 0) {
          liveFeedback.textContent = 'Книги не найдены';
        } else {
          const mod10 = visibleCount % 10;
          const mod100 = visibleCount % 100;
          let word = 'книг';
          if (mod100 < 11 || mod100 > 14) {
            if (mod10 === 1) word = 'книга';
            else if (mod10 >= 2 && mod10 <= 4) word = 'книги';
          }
          liveFeedback.textContent = `Найдено ${visibleCount} ${word}`;
        }
      }

      updateActiveNavUI();
    }

    // Search events with 250ms debounce and Enter instant trigger (DESIGN.md 8.1)
    searchInput?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      if (searchClearBtn) {
        if (val.trim()) {
          searchClearBtn.classList.remove('hidden');
        } else {
          searchClearBtn.classList.add('hidden');
        }
      }
      if (searchDebounceTimer) {
        clearTimeout(searchDebounceTimer);
      }
      searchDebounceTimer = window.setTimeout(() => {
        searchQuery = normalize(val);
        applyFilterAndSort();
      }, 250);
    });

    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        if (searchDebounceTimer) {
          clearTimeout(searchDebounceTimer);
          searchDebounceTimer = undefined;
        }
        searchQuery = normalize((searchInput as HTMLInputElement).value);
        applyFilterAndSort();
      }
    });

    searchClearBtn?.addEventListener('click', () => {
      if (searchInput) {
        if (searchDebounceTimer) {
          clearTimeout(searchDebounceTimer);
          searchDebounceTimer = undefined;
        }
        searchInput.value = '';
        searchQuery = '';
        searchClearBtn.classList.add('hidden');
        searchInput.focus();
        applyFilterAndSort();
      }
    });

    // Sort buttons event binding
    sortBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const sortVal = (btn as HTMLElement).dataset.sort || 'recent';
        currentSort = sortVal;

        sortBtns.forEach((b) => {
          const isCurrent = (b as HTMLElement).dataset.sort === currentSort;
          if (isCurrent) {
            b.classList.add('bg-[var(--color-primary)]', 'text-[var(--color-on-primary)]', 'shadow-xs');
            b.classList.remove('text-[var(--color-text)]', 'hover:bg-[var(--color-hover-surface)]');
            b.setAttribute('aria-pressed', 'true');
          } else {
            b.classList.remove('bg-[var(--color-primary)]', 'text-[var(--color-on-primary)]', 'shadow-xs');
            b.classList.add('text-[var(--color-text)]', 'hover:bg-[var(--color-hover-surface)]');
            b.setAttribute('aria-pressed', 'false');
          }
        });

        applyFilterAndSort();
      });
    });

    function syncUrlGenre() {
      const url = new URL(window.location.href);
      if (selectedGenre) {
        url.searchParams.set('genre', selectedGenre);
      } else {
        url.searchParams.delete('genre');
      }
      window.history.pushState({}, '', url.pathname + url.search);
    }

    // Reset filters
    function resetAllFilters() {
      selectedGenre = '';
      syncUrlGenre();
      applyFilterAndSort();
    }

    resetAllBtn?.addEventListener('click', () => {
      if (searchInput) {
        if (searchDebounceTimer) {
          clearTimeout(searchDebounceTimer);
          searchDebounceTimer = undefined;
        }
        searchInput.value = '';
        searchQuery = '';
        searchClearBtn?.classList.add('hidden');
      }
      resetAllFilters();
    });

    // Sidebar tags binding
    navGenreBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        // Prevent page navigation since we're already on index page
        e.preventDefault();

        const genre = normalize((btn as HTMLElement).dataset.navGenre || '');
        if (selectedGenre === genre && genre !== '') {
          selectedGenre = ''; // toggle off if clicked again
        } else {
          selectedGenre = genre;
        }
        syncUrlGenre();
        applyFilterAndSort();

        // Close mobile drawer if open
        const drawer = document.getElementById('mobile-drawer');
        if (drawer && !drawer.classList.contains('-translate-x-full')) {
          document.getElementById('close-drawer-btn')?.click();
        }
      });
    });

    // Listen to browser back/forward buttons (idempotent registration)
    function onPopState() {
      const paramGenre = new URLSearchParams(window.location.search).get('genre');
      selectedGenre = paramGenre ? normalize(paramGenre) : '';
      applyFilterAndSort();
    }
    window.removeEventListener('popstate', onPopState);
    window.addEventListener('popstate', onPopState);

    // Keyboard shortcut '/' to focus search without hijacking system combinations
    function onKeyDown(e: KeyboardEvent) {
      if (
        e.key === '/' &&
        !e.ctrlKey &&
        !e.metaKey &&
        !e.altKey &&
        document.activeElement !== searchInput &&
        !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')
      ) {
        e.preventDefault();
        searchInput?.focus();
      }
    }
    window.removeEventListener('keydown', onKeyDown);
    window.addEventListener('keydown', onKeyDown);

    // Initial run
    applyFilterAndSort();
  }

  initCatalogController();
  document.addEventListener('astro:after-swap', initCatalogController);
</script>
