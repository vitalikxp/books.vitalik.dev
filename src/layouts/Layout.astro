---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import Sidebar from '../components/Sidebar.astro';
import { BookOpen, Menu } from '@lucide/astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Моя библиотека',
  description = 'Каталог домашней библиотеки',
} = Astro.props;

const allBooks = await getCollection('books');
const totalBooks = allBooks.length;

// Extract genres with counts, normalized by lower-case key to avoid duplicates, sorted by count descending then alphabetically
const genreMap = new Map<string, { name: string; count: number }>();
allBooks.forEach((b) => {
  b.data.genres.forEach((g) => {
    const trimmed = (g || '').trim();
    if (trimmed) {
      const key = trimmed.toLowerCase().replace(/ё/g, 'е');
      const existing = genreMap.get(key);
      if (existing) {
        existing.count += 1;
      } else {
        genreMap.set(key, { name: trimmed, count: 1 });
      }
    }
  });
});
const genres = Array.from(genreMap.values())
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'ru'));
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Lora (Display serif) + Inter (UI sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:ital,wght@0,500;0,600;0,700;1,400&subset=cyrillic&display=swap"
      rel="stylesheet"
    />

    <title>{title} — Моя библиотека</title>
    <meta name="description" content={description} />

    <!-- Synchronous early theme resolution from localStorage and system preference (prevents FOUC) -->
    <script is:inline>
      (() => {
        const key = 'my-library.theme';
        const allowed = new Set(['system', 'light', 'dark']);
        let preference = 'system';
        try {
          const saved = localStorage.getItem(key);
          if (allowed.has(saved)) preference = saved;
        } catch {}

        const mq = window.matchMedia('(prefers-color-scheme: dark)');
        function resolveTheme(pref) {
          if (pref === 'system') {
            return mq.matches ? 'dark' : 'light';
          }
          return pref;
        }

        document.documentElement.dataset.theme = resolveTheme(preference);
        document.documentElement.dataset.themePreference = preference;

        function updateSystemTheme(e) {
          const currentPref = document.documentElement.dataset.themePreference;
          if (currentPref === 'system') {
            document.documentElement.dataset.theme = e.matches ? 'dark' : 'light';
          }
        }
        if (mq.addEventListener) {
          mq.addEventListener('change', updateSystemTheme);
        }
      })();
    </script>

    <!-- Global image fallback listener with loop guard -->
    <script is:inline>
      document.addEventListener(
        'error',
        (e) => {
          const el = e.target;
          if (el && el.tagName === 'IMG' && el.dataset.fallback && !el.dataset.fallbackApplied) {
            el.dataset.fallbackApplied = 'true';
            el.src = el.dataset.fallback;
          }
        },
        true
      );
    </script>
  </head>
  <body class="bg-[var(--color-page)] text-[var(--color-text)] font-sans antialiased min-h-screen relative selection:bg-[var(--color-primary)]/25 selection:text-inherit">

    <!-- Skip link for keyboard accessibility -->
    <a 
      href="#main-content" 
      id="skip-to-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-[var(--color-primary)] focus:text-[var(--color-on-primary)] focus:rounded-lg focus:shadow-lg focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-[var(--color-focus)] focus-visible:ring-offset-3"
    >
      Перейти к книгам
    </a>

    <!-- Mobile Top Navigation (< 1024px) -->
    <header class="lg:hidden sticky top-0 z-30 flex items-center justify-between px-4 sm:px-6 h-16 bg-[var(--color-sidebar)]/95 backdrop-blur-md border-b border-[var(--color-line)]">
      <div class="flex items-center gap-3">
        <button
          type="button"
          id="open-drawer-btn"
          class="min-w-[44px] min-h-[44px] flex items-center justify-center p-2 -ml-2 text-[var(--color-text)] hover:bg-[var(--color-hover-surface)] rounded-lg transition-colors cursor-pointer"
          aria-label="Открыть ярлыки"
        >
          <Menu class="w-6 h-6 stroke-[1.8]" />
        </button>

        <a href="/" class="flex items-center gap-2 text-[var(--color-heading)]">
          <BookOpen class="w-6 h-6 stroke-[1.8] text-[var(--color-primary)]" />
          <span class="font-['Lora'] text-[24px] leading-[32px] font-medium tracking-tight">
            Моя библиотека
          </span>
        </a>
      </div>
    </header>

    <!-- Mobile Navigation Drawer -->
    <div 
      id="mobile-drawer-overlay"
      class="fixed inset-0 z-40 bg-[var(--color-scrim)] backdrop-blur-xs hidden pointer-events-none transition-opacity duration-200 lg:hidden"
      aria-hidden="true"
    ></div>
    <div 
      id="mobile-drawer"
      class="fixed inset-y-0 left-0 z-50 w-[min(310px,88vw)] bg-[var(--color-sidebar)] shadow-2xl transform -translate-x-full transition-transform duration-250 ease-out lg:hidden"
      role="dialog"
      aria-modal="true"
      aria-label="Ярлыки библиотеки"
      inert
    >
      <Sidebar 
        totalBooks={totalBooks}
        genres={genres}
        isMobileDrawer={true} 
      />
    </div>

    <!-- Desktop Master Layout -->
    <div class="flex min-h-screen">
      <!-- Desktop Fixed Sidebar -->
      <div class="hidden lg:block shrink-0 sticky top-0 h-screen w-[var(--sidebar-width)] z-20">
        <Sidebar 
          totalBooks={totalBooks}
          genres={genres}
          isMobileDrawer={false} 
        />
      </div>

      <!-- Main Catalog & Pages Area -->
      <main id="main-content" tabindex="-1" aria-label="Книги" class="flex-1 min-w-0 bg-[var(--color-page)] focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-[var(--color-focus)] focus-visible:ring-offset-3 rounded-lg">
        <slot />
      </main>
    </div>

    <!-- Layout Global Scripts -->
    <script>
      let closeDrawerTimeout: number | undefined;
      let openDrawerTimeout: number | undefined;
      let escapeKeyListener: ((e: KeyboardEvent) => void) | null = null;
      let mediaQueryList: MediaQueryList | null = null;
      let mediaQueryListener: ((e: MediaQueryListEvent) => void) | null = null;

      function initLayout() {
        document.body.style.overflow = '';
        document.getElementById('main-content')?.removeAttribute('inert');
        document.getElementById('skip-to-content')?.removeAttribute('inert');
        document.querySelector('header')?.removeAttribute('inert');

        const openDrawerBtn = document.getElementById('open-drawer-btn');
        const closeDrawerBtn = document.getElementById('close-drawer-btn');
        const drawerOverlay = document.getElementById('mobile-drawer-overlay');
        const drawer = document.getElementById('mobile-drawer');

        function openDrawer() {
          if (!drawer || !drawerOverlay) return;
          if (closeDrawerTimeout) {
            clearTimeout(closeDrawerTimeout);
            closeDrawerTimeout = undefined;
          }
          if (openDrawerTimeout) {
            clearTimeout(openDrawerTimeout);
            openDrawerTimeout = undefined;
          }
          drawer.removeAttribute('inert');
          drawerOverlay.classList.remove('pointer-events-none');
          drawerOverlay.classList.remove('hidden');
          document.getElementById('main-content')?.setAttribute('inert', '');
          document.getElementById('skip-to-content')?.setAttribute('inert', '');
          document.querySelector('header')?.setAttribute('inert', '');
          openDrawerTimeout = window.setTimeout(() => {
            drawer.classList.remove('-translate-x-full');
            closeDrawerBtn?.focus();
            openDrawerTimeout = undefined;
          }, 10);
          document.body.style.overflow = 'hidden';
        }

        function closeDrawer(focusTarget: 'button' | 'main' = 'button') {
          if (!drawer || !drawerOverlay) return;
          const isDrawerOpen = drawer && !drawer.classList.contains('-translate-x-full');
          if (!isDrawerOpen && (!drawerOverlay || drawerOverlay.classList.contains('hidden'))) {
            return;
          }
          if (openDrawerTimeout) {
            clearTimeout(openDrawerTimeout);
            openDrawerTimeout = undefined;
          }
          drawerOverlay.classList.add('pointer-events-none');
          drawer.classList.add('-translate-x-full');
          drawer.setAttribute('inert', '');
          document.getElementById('main-content')?.removeAttribute('inert');
          document.getElementById('skip-to-content')?.removeAttribute('inert');
          document.querySelector('header')?.removeAttribute('inert');
          if (closeDrawerTimeout) {
            clearTimeout(closeDrawerTimeout);
          }
          closeDrawerTimeout = window.setTimeout(() => {
            drawerOverlay.classList.add('hidden');
            document.body.style.overflow = '';
            closeDrawerTimeout = undefined;
          }, 250);
          if (focusTarget === 'main') {
            document.getElementById('main-content')?.focus();
          } else {
            if (window.innerWidth < 1024) {
              openDrawerBtn?.focus();
            }
          }
        }

        (window as any).closeDrawer = closeDrawer;

        openDrawerBtn?.addEventListener('click', openDrawer);
        closeDrawerBtn?.addEventListener('click', () => closeDrawer('button'));
        drawerOverlay?.addEventListener('click', () => closeDrawer('button'));

        // Clean up previous listeners if any to prevent leaks across page swaps
        if (mediaQueryList && mediaQueryListener) {
          mediaQueryList.removeEventListener('change', mediaQueryListener);
          mediaQueryList = null;
          mediaQueryListener = null;
        }
        mediaQueryList = window.matchMedia('(min-width: 1024px)');
        mediaQueryListener = (e: MediaQueryListEvent) => {
          if (e.matches) closeDrawer();
        };
        mediaQueryList.addEventListener('change', mediaQueryListener);

        if (escapeKeyListener) {
          window.removeEventListener('keydown', escapeKeyListener);
          escapeKeyListener = null;
        }
        escapeKeyListener = (e: KeyboardEvent) => {
          if (e.key === 'Escape' && drawer && !drawer.hasAttribute('inert')) {
            closeDrawer('button');
          }
        };
        window.addEventListener('keydown', escapeKeyListener);

        // Theme controller: sync button states with current preference and localStorage
        const themeBtns = document.querySelectorAll('.theme-btn') as NodeListOf<HTMLButtonElement>;
        const themeRadioGroups = document.querySelectorAll('.theme-radiogroup');

        function applyThemePreference(pref: string) {
          try {
            localStorage.setItem('my-library.theme', pref);
          } catch {}
          document.documentElement.dataset.themePreference = pref;

          const mq = window.matchMedia('(prefers-color-scheme: dark)');
          const resolved = pref === 'system' ? (mq.matches ? 'dark' : 'light') : pref;
          document.documentElement.dataset.theme = resolved;

          themeBtns.forEach((btn) => {
            const isCurrent = btn.dataset.themeVal === pref;
            if (isCurrent) {
              btn.setAttribute('aria-checked', 'true');
              btn.setAttribute('tabindex', '0');
              btn.classList.add('bg-[var(--color-primary)]', 'text-[var(--color-on-primary)]', 'shadow-xs', 'font-medium');
              btn.classList.remove('text-[var(--color-text)]', 'hover:bg-[var(--color-hover-surface)]', 'font-normal');
            } else {
              btn.setAttribute('aria-checked', 'false');
              btn.setAttribute('tabindex', '-1');
              btn.classList.remove('bg-[var(--color-primary)]', 'text-[var(--color-on-primary)]', 'shadow-xs', 'font-medium');
              btn.classList.add('text-[var(--color-text)]', 'hover:bg-[var(--color-hover-surface)]', 'font-normal');
            }
          });
        }

        const initialPref = document.documentElement.dataset.themePreference || 'system';
        applyThemePreference(initialPref);

        themeBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const val = btn.dataset.themeVal || 'system';
            applyThemePreference(val);
          });
        });

        // Roving tabindex keyboard navigation with Arrow keys
        themeRadioGroups.forEach((group) => {
          group.addEventListener('keydown', (e) => {
            const keyEvent = e as KeyboardEvent;
            const buttons = Array.from(group.querySelectorAll('.theme-btn')) as HTMLButtonElement[];
            const currentPrefNow = document.documentElement.dataset.themePreference || 'system';
            const currentIndex = buttons.findIndex((b) => b.dataset.themeVal === currentPrefNow);
            if (currentIndex === -1) return;

            let newIndex = -1;
            if (keyEvent.key === 'ArrowRight' || keyEvent.key === 'ArrowDown') {
              newIndex = (currentIndex + 1) % buttons.length;
            } else if (keyEvent.key === 'ArrowLeft' || keyEvent.key === 'ArrowUp') {
              newIndex = (currentIndex - 1 + buttons.length) % buttons.length;
            }

            if (newIndex !== -1) {
              keyEvent.preventDefault();
              const targetVal = buttons[newIndex].dataset.themeVal || 'system';
              applyThemePreference(targetVal);
              buttons[newIndex].focus();
            }
          });
        });
      }

      // Teardown before page swap
      document.addEventListener('astro:before-swap', () => {
        document.body.style.overflow = '';
        document.getElementById('main-content')?.removeAttribute('inert');
        document.getElementById('skip-to-content')?.removeAttribute('inert');
        document.querySelector('header')?.removeAttribute('inert');
        if (escapeKeyListener) {
          window.removeEventListener('keydown', escapeKeyListener);
          escapeKeyListener = null;
        }
        if (mediaQueryList && mediaQueryListener) {
          mediaQueryList.removeEventListener('change', mediaQueryListener);
          mediaQueryList = null;
          mediaQueryListener = null;
        }
        if (closeDrawerTimeout) {
          clearTimeout(closeDrawerTimeout);
          closeDrawerTimeout = undefined;
        }
        if (openDrawerTimeout) {
          clearTimeout(openDrawerTimeout);
          openDrawerTimeout = undefined;
        }
      });

      initLayout();
      document.addEventListener('astro:after-swap', initLayout);
    </script>
  </body>
</html>
