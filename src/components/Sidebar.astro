---
import { BookOpen, Tag, Library, X, SunMoon } from '@lucide/astro';
import TagIcon from './TagIcon.astro';

interface Props {
  totalBooks?: number;
  genres?: Array<{ name: string; count: number }>;
  isMobileDrawer?: boolean;
}

const {
  totalBooks = 0,
  genres = [],
  isMobileDrawer = false,
} = Astro.props;
const isHome = Astro.url.pathname === '/';
const currentGenre = Astro.url.searchParams.get('genre')?.toLowerCase().trim() || '';
const isAllBooksSelected = isHome && !currentGenre;
---

<aside 
  class={`flex flex-col h-full bg-[var(--color-sidebar)] select-none ${isMobileDrawer ? 'w-full py-5 pl-4 pr-1' : 'w-[var(--sidebar-width)] p-6 lg:p-7 border-r border-[var(--color-line)]'}`}
  aria-label="Боковая навигация по библиотеке"
>
  <!-- Header: Logo / Branding & Mobile Drawer Close Button -->
  <div class="flex items-center justify-between mb-8 shrink-0 pr-3">
    <a 
      href="/" 
      class="flex items-center gap-3.5 group text-[var(--color-heading)] focus-visible:rounded-lg"
      aria-label="Моя библиотека — главная страница"
    >
      <div class="text-[var(--color-heading)] group-hover:text-[var(--color-primary)] transition-colors">
        <BookOpen class={`${isMobileDrawer ? 'w-6 h-6' : 'w-8 h-8'} stroke-[1.8]`} />
      </div>
      <span class={`font-['Lora'] ${isMobileDrawer ? 'text-[22px]' : 'text-[28px] leading-[36px]'} font-medium text-[var(--color-heading)] tracking-[-0.01em]`}>
        Моя библиотека
      </span>
    </a>
    {isMobileDrawer && (
      <button
        type="button"
        id="close-drawer-btn"
        class="min-w-[44px] min-h-[44px] flex items-center justify-center p-2 -mr-1 text-[var(--color-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-hover-surface)] rounded-lg transition-colors cursor-pointer"
        aria-label="Закрыть навигацию"
      >
        <X class="w-5 h-5 stroke-[1.8]" />
      </button>
    )}
  </div>

  <!-- Navigation items -->
  <nav class={`flex-1 overflow-y-auto space-y-6 ${isMobileDrawer ? 'pr-2' : 'pr-1 -mr-1'}`} aria-label="Разделы каталога">
    <!-- Tags Section in Sidebar -->
    <div>
      <div class="px-3 mb-2.5 text-[13px] font-medium tracking-[0.08em] text-[var(--color-muted)] uppercase flex items-center gap-2">
        <Tag class="w-3.5 h-3.5 stroke-[2]" />
        <span>ЯРЛЫКИ</span>
      </div>
      <ul class="space-y-0.5" role="list">
        <!-- All Books (Reset Tag Filter) -->
        <li>
          <a
            href="/"
            data-nav-genre=""
            aria-current={isAllBooksSelected ? 'page' : undefined}
            class={`nav-genre-btn w-full min-h-[44px] flex items-center justify-between px-3.5 py-2.5 rounded-[var(--radius-nav)] text-[15px] transition-colors cursor-pointer text-left group ${
              isAllBooksSelected
                ? 'bg-[var(--color-primary)] text-[var(--color-on-primary)] font-medium'
                : 'text-[var(--color-text)] hover:bg-[var(--color-hover-surface)] font-normal'
            }`}
          >
            <div class="flex items-center gap-2.5 min-w-0">
              <span class={`tag-icon-wrap shrink-0 ${isAllBooksSelected ? 'text-[var(--color-on-primary)]' : 'text-[var(--color-muted)]'} group-hover:text-[var(--color-text)] transition-colors`}>
                <Library class="w-4 h-4 stroke-[1.8]" />
              </span>
              <span class="truncate">Все книги</span>
            </div>
            {totalBooks > 0 && (
              <span class={`genre-count font-mono text-[13px] shrink-0 ml-2 ${isAllBooksSelected ? 'text-[var(--color-on-primary)]' : 'text-[var(--color-muted)]'} group-hover:text-[var(--color-text)]`}>
                {totalBooks}
              </span>
            )}
          </a>
        </li>

        <!-- Specific Tag Items -->
        {genres.map((g) => {
          const isGenreActive = isHome && currentGenre === g.name.toLowerCase();
          return (
            <li>
              <a
                href={`/?genre=${encodeURIComponent(g.name.toLowerCase())}`}
                data-nav-genre={g.name.toLowerCase()}
                aria-current={isGenreActive ? 'page' : undefined}
                class={`nav-genre-btn w-full min-h-[44px] flex items-center justify-between px-3.5 py-2.5 rounded-[var(--radius-nav)] text-[15px] transition-colors cursor-pointer text-left group ${
                  isGenreActive
                    ? 'bg-[var(--color-primary)] text-[var(--color-on-primary)] font-medium'
                    : 'text-[var(--color-text)] hover:bg-[var(--color-hover-surface)] font-normal'
                }`}
              >
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class={`tag-icon-wrap shrink-0 ${isGenreActive ? 'text-[var(--color-on-primary)]' : 'text-[var(--color-muted)]'} group-hover:text-[var(--color-text)] transition-colors`}>
                    <TagIcon tag={g.name} class="w-4 h-4 stroke-[1.8]" />
                  </span>
                  <span class="truncate">{g.name}</span>
                </div>
                <span class={`genre-count font-mono text-[13px] shrink-0 ml-2 ${isGenreActive ? 'text-[var(--color-on-primary)]' : 'text-[var(--color-muted)]'} group-hover:text-[var(--color-text)]`}>
                  {g.count}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    <!-- Theme Selection (DESIGN.md 10.2) -->
    <div class="pt-6 border-t border-[var(--color-line)] mt-6">
      <label for={isMobileDrawer ? 'theme-select-mobile' : 'theme-select'} class="block text-[13px] font-medium tracking-[0.08em] text-[var(--color-muted)] uppercase mb-2 flex items-center gap-2">
        <SunMoon class="w-3.5 h-3.5 stroke-[2]" />
        <span>ТЕМА</span>
      </label>
      <div class="relative">
        <select
          id={isMobileDrawer ? 'theme-select-mobile' : 'theme-select'}
          class="theme-select-input w-full min-h-[44px] px-3.5 py-2.5 bg-[var(--color-surface)] border border-[var(--color-control-border)] rounded-[var(--radius-control)] text-[14px] text-[var(--color-text)] focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-[var(--color-focus)] focus-visible:ring-offset-3 cursor-pointer transition-colors"
          aria-label="Выбор цветовой темы"
        >
          <option value="system">Системная</option>
          <option value="light">Светлая</option>
          <option value="dark">Тёмная</option>
        </select>
      </div>
    </div>
  </nav>
</aside>
