---
import { BookOpen, Tag, Library, X, SunMoon, Sun, Moon, Monitor } from '@lucide/astro';
import TagIcon from './TagIcon.astro';
import { normalize } from '../utils/catalog.js';

interface Props {
  totalBooks?: number;
  genres?: Array<{ name: string; count: number }>;
  isMobileDrawer?: boolean;
}

const {
  totalBooks = 0,
  genres = [],
  isMobileDrawer = false,
} = Astro.props;
const isHome = Astro.url.pathname === '/';
const currentGenre = normalize(Astro.url.searchParams.get('genre') || '');
const isAllBooksSelected = isHome && !currentGenre;
---

<aside 
  class={`flex flex-col h-full bg-[var(--color-sidebar)] select-none ${isMobileDrawer ? 'w-full py-5 pl-4 pr-1' : 'w-[var(--sidebar-width)] p-6 border-r border-[var(--color-line)]'}`}
  aria-label="Боковая навигация по библиотеке"
>
  <!-- Header: Logo / Branding & Mobile Drawer Close Button -->
  <div class={`flex items-center justify-between mb-8 shrink-0 ${isMobileDrawer ? 'pr-3' : ''}`}>
    <a 
      href="/" 
      class="flex items-center gap-3 group text-[var(--color-heading)] focus-visible:rounded-lg min-w-0"
      aria-label="Моя библиотека — главная страница"
    >
      <div class="text-[var(--color-heading)] group-hover:text-[var(--color-primary)] transition-colors shrink-0">
        <BookOpen class={`${isMobileDrawer ? 'w-6 h-6' : 'w-7.5 h-7.5'} stroke-[1.8]`} />
      </div>
      <span class={`font-['Lora'] ${isMobileDrawer ? 'text-[22px]' : 'text-[24px] xl:text-[26px] leading-[32px]'} font-medium text-[var(--color-heading)] tracking-[-0.01em] whitespace-nowrap`}>
        Моя библиотека
      </span>
    </a>
    {isMobileDrawer && (
      <button
        type="button"
        id="close-drawer-btn"
        class="min-w-[44px] min-h-[44px] flex items-center justify-center p-2 -mr-1 text-[var(--color-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-hover-surface)] rounded-lg transition-colors cursor-pointer"
        aria-label="Закрыть навигацию"
      >
        <X class="w-5 h-5 stroke-[1.8]" />
      </button>
    )}
  </div>

  <!-- Navigation items -->
  <nav class={`flex-1 overflow-y-auto space-y-6 ${isMobileDrawer ? 'pr-2' : 'pr-1 -mr-1'}`} aria-label="Разделы каталога">
    <!-- Theme Selection (above Labels) -->
    <div class="pb-6 border-b border-[var(--color-line)]">
      <div class="px-1 mb-2 text-[13px] font-medium tracking-[0.08em] text-[var(--color-muted)] uppercase flex items-center gap-2">
        <SunMoon class="w-3.5 h-3.5 stroke-[2]" />
        <span>ТЕМА</span>
      </div>
      <div
        class="theme-radiogroup w-full min-h-[44px] p-1 bg-[var(--color-surface)] border border-[var(--color-control-border)] rounded-[var(--radius-control)] flex items-center gap-1"
        role="radiogroup"
        aria-label="Выбор цветовой темы"
      >
        <button
          type="button"
          class="theme-btn flex-1 h-[36px] px-2 rounded-[6px] transition-colors cursor-pointer flex items-center justify-center bg-[var(--color-primary)] text-[var(--color-on-primary)] shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus)]"
          data-theme-val="system"
          role="radio"
          aria-checked="true"
          tabindex="0"
          title="Системная тема"
          aria-label="Системная тема"
        >
          <Monitor class="w-4 h-4 stroke-[1.8] shrink-0" />
          <span class="sr-only">Системная тема</span>
        </button>
        <button
          type="button"
          class="theme-btn flex-1 h-[36px] px-2 rounded-[6px] transition-colors cursor-pointer flex items-center justify-center text-[var(--color-text)] hover:bg-[var(--color-hover-surface)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus)]"
          data-theme-val="light"
          role="radio"
          aria-checked="false"
          tabindex="-1"
          title="Светлая тема"
          aria-label="Светлая тема"
        >
          <Sun class="w-4 h-4 stroke-[1.8] shrink-0" />
          <span class="sr-only">Светлая тема</span>
        </button>
        <button
          type="button"
          class="theme-btn flex-1 h-[36px] px-2 rounded-[6px] transition-colors cursor-pointer flex items-center justify-center text-[var(--color-text)] hover:bg-[var(--color-hover-surface)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-focus)]"
          data-theme-val="dark"
          role="radio"
          aria-checked="false"
          tabindex="-1"
          title="Тёмная тема"
          aria-label="Тёмная тема"
        >
          <Moon class="w-4 h-4 stroke-[1.8] shrink-0" />
          <span class="sr-only">Тёмная тема</span>
        </button>
      </div>
    </div>

    <!-- Tags Section in Sidebar -->
    <div>
      <div class="px-3 mb-2.5 text-[13px] font-medium tracking-[0.08em] text-[var(--color-muted)] uppercase flex items-center gap-2">
        <Tag class="w-3.5 h-3.5 stroke-[2]" />
        <span>ЯРЛЫКИ</span>
      </div>
      <ul class="space-y-0.5" role="list">
        <!-- All Books (Reset Tag Filter) -->
        <li>
          <a
            href="/"
            data-nav-genre=""
            aria-current={isAllBooksSelected ? 'page' : undefined}
            class={`nav-genre-btn w-full min-h-[44px] flex items-center justify-between px-3.5 py-2.5 rounded-[var(--radius-nav)] text-[15px] transition-colors cursor-pointer text-left group ${
              isAllBooksSelected
                ? 'bg-[var(--color-primary)] text-[var(--color-on-primary)] font-medium'
                : 'text-[var(--color-text)] hover:bg-[var(--color-hover-surface)] font-normal'
            }`}
          >
            <div class="flex items-center gap-2.5 min-w-0">
              <span class={`tag-icon-wrap shrink-0 ${isAllBooksSelected ? 'text-[var(--color-on-primary)]' : 'text-[var(--color-muted)]'} group-hover:text-[var(--color-text)] transition-colors`}>
                <Library class="w-4 h-4 stroke-[1.8]" />
              </span>
              <span class="truncate">Все книги</span>
            </div>
            {totalBooks > 0 && (
              <span class={`genre-count font-mono text-[13px] shrink-0 ml-2 ${isAllBooksSelected ? 'text-[var(--color-on-primary)]' : 'text-[var(--color-muted)]'} group-hover:text-[var(--color-text)]`}>
                {totalBooks}
              </span>
            )}
          </a>
        </li>

        <!-- Specific Tag Items -->
        {genres.map((g) => {
          const isGenreActive = isHome && currentGenre === normalize(g.name);
          return (
            <li>
              <a
                href={`/?genre=${encodeURIComponent(g.name.toLowerCase())}`}
                data-nav-genre={g.name.toLowerCase()}
                aria-current={isGenreActive ? 'page' : undefined}
                class={`nav-genre-btn w-full min-h-[44px] flex items-center justify-between px-3.5 py-2.5 rounded-[var(--radius-nav)] text-[15px] transition-colors cursor-pointer text-left group ${
                  isGenreActive
                    ? 'bg-[var(--color-primary)] text-[var(--color-on-primary)] font-medium'
                    : 'text-[var(--color-text)] hover:bg-[var(--color-hover-surface)] font-normal'
                }`}
              >
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class={`tag-icon-wrap shrink-0 ${isGenreActive ? 'text-[var(--color-on-primary)]' : 'text-[var(--color-muted)]'} group-hover:text-[var(--color-text)] transition-colors`}>
                    <TagIcon tag={g.name} class="w-4 h-4 stroke-[1.8]" />
                  </span>
                  <span class="truncate">{g.name}</span>
                </div>
                <span class={`genre-count font-mono text-[13px] shrink-0 ml-2 ${isGenreActive ? 'text-[var(--color-on-primary)]' : 'text-[var(--color-muted)]'} group-hover:text-[var(--color-text)]`}>
                  {g.count}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </nav>
</aside>
