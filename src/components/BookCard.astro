---
import type { CollectionEntry } from 'astro:content';
import TagIcon from './TagIcon.astro';

interface Props {
  book: CollectionEntry<'books'>;
}

const { book } = Astro.props;
const data = book.data;
---

<article 
  class="book-item group flex flex-col w-full text-left"
  data-id={book.id}
  data-title={data.title.toLowerCase()}
  data-author={data.author.toLowerCase()}
  data-isbn={(data.isbn || '').replace(/^isbn[:\s]*/i, '').replace(/[-\s\u2010-\u2015\u2212]/g, '').toLowerCase()}
  data-genres={JSON.stringify(data.genres.map((g: string) => g.toLowerCase()))}
  data-added={new Date(data.addedAt).getTime()}
  data-year={data.year || 0}
>
  <!-- Book Cover Container: Ratio 55/78, max-h 312px, aligned bottom, soft shadow -->
  <div class="w-full relative aspect-[55/78] max-h-[312px] flex items-end justify-center mb-3">
    <a 
      href={`/books/${book.id}`}
      tabindex="-1"
      aria-hidden="true"
      class="block relative max-w-full max-h-full book-cover-container transition-transform duration-150 focus-visible:ring-3 focus-visible:ring-[var(--color-focus)] focus-visible:ring-offset-3"
    >
      <img 
        src={data.cover} 
        alt="" 
        loading="lazy"
        class="w-auto h-auto max-h-[312px] max-w-full object-contain object-bottom block rounded-[var(--radius-cover)]"
        data-fallback="/covers/default-book.svg"
      />
      <!-- Tactile spine lighting overlay -->
      <div class="book-spine-line"></div>
    </a>
  </div>

  <!-- Title: Inter 18/24px, weight 600, max 2 lines (min-h-[48px] reserves 2 lines as per DESIGN.md 9.1) -->
  <h2 class="text-[18px] leading-[24px] font-semibold text-[var(--color-text)] line-clamp-2 min-h-[48px] mb-1 group-hover:text-[var(--color-primary)] transition-colors">
    <a href={`/books/${book.id}`} class="hover:underline focus-visible:underline">
      {data.title}
    </a>
  </h2>

  <!-- Author: Inter 16/22px, weight 400, max 2 lines -->
  <p class="text-[16px] leading-[22px] font-normal text-[var(--color-muted)] line-clamp-2 mb-2">{data.author || 'Автор не указан'}</p>

  <!-- Book Labels (Tags) from DESIGN.md 9.3 (gap 6px = gap-1.5, fixed 8px margin after author) -->
  {data.genres && data.genres.length > 0 && (
    <div class="flex flex-wrap gap-1.5 items-center">
      {data.genres.map((genre: string) => (
        <span class="inline-flex items-center gap-1 text-[12px] leading-[16px] font-normal px-2 py-0.5 min-h-[22px] rounded-[var(--radius-pill)] bg-[var(--color-tag-bg)] text-[var(--color-tag-text)] border border-[var(--color-tag-border)]">
          <TagIcon tag={genre} class="w-3 h-3 stroke-[2] shrink-0" />
          <span>{genre}</span>
        </span>
      ))}
    </div>
  )}
</article>
